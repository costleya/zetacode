{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--enable-proposed-api=s-obvious.nesweep"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.mjs"],
      "preLaunchTask": "Build extension"
    }
  ]
}
