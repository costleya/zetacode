# Typed server surface for the generated gRPC bindings. Message types are
# generated by protoc; this small service contract follows completion.proto.
from collections.abc import Iterator
import grpc
import completion_pb2

class CompletionServiceServicer:
    def Complete(self, request: completion_pb2.CompletionRequest, context: grpc.ServicerContext) -> Iterator[completion_pb2.CompletionEvent]: ...
    def Health(self, request: completion_pb2.HealthRequest, context: grpc.ServicerContext) -> completion_pb2.HealthResponse: ...

def add_CompletionServiceServicer_to_server(servicer: CompletionServiceServicer, server: grpc.Server) -> None: ...
